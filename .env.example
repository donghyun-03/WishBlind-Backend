# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# .env는 절대 git에 커밋 금지 (.gitignore에 이미 포함).

# 앱이 접속할 DB 이름 / 계정
DB_NAME=wishblind
DB_USERNAME=root
DB_PASSWORD=changeme

# docker-compose의 mysql 컨테이너 root 비밀번호 (보통 DB_PASSWORD와 동일하게)
DB_ROOT_PASSWORD=changeme

# JWT 서명 키. 32바이트 이상이어야 앱이 뜬다. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 소셜 로그인 (앱이 SDK로 받은 access token을 서버가 제공자에게 검증하는 방식이라
# 서버에는 별도 시크릿이 필요 없다. 아래는 콘솔 설정 확인용 메모)
#  - 카카오: developers.kakao.com → 앱 → 카카오 로그인 활성화 → 동의항목에서 닉네임/이메일 ON
#  - 구글:   console.cloud.google.com → OAuth 클라이언트 ID (Android/iOS)
#
# 아래 두 값은 "토큰이 우리 앱에 발급된 것인지" 대조하는 데 쓴다. 시크릿은 아니지만
# 없으면 소셜 로그인이 거부된다(토큰 치환 공격을 막기 위한 fail-closed 동작).
GOOGLE_CLIENT_ID=
KAKAO_APP_ID=

# AI 연결 (Gemini). aistudio.google.com 에서 발급
GEMINI_API_KEY=
